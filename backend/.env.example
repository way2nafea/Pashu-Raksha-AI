# REQUIRED for any real run (local dev walkthrough, SIH judged demo, or
# production): a real MongoDB connection string. Examples:
#   Local:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
#
# If left empty, the backend falls back to an IN-MEMORY database (mongomock)
# purely as a zero-install developer convenience. That fallback never
# auto-seeds data, and — critically — does NOT persist across restarts. It
# must never be used for evaluation or production. The backend logs a loud
# warning on startup whenever it is running this way.
MONGODB_URI=
MONGODB_DB=pashurakshak

# Change this in production. Used to sign JWT access tokens.
JWT_SECRET=dev-secret-change-me-in-production

# Comma-separated frontend origins. Add the host laptop's LAN origin when
# using the app from another device, e.g. http://192.168.X.X:3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Maps Platform Weather API + Air Quality API. When set, Google is the
# preferred provider; without it the backend uses the Open-Meteo fallback.
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# Outbreak detection tuning (see docs/outbreak-detection.md)
OUTBREAK_RADIUS_KM=10
OUTBREAK_TIME_WINDOW_DAYS=14
OUTBREAK_MIN_CASES=3
NEARBY_CASE_RADIUS_KM=15

# Optional future integrations (not required for the prototype;
# image upload currently stores a placeholder reference only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
